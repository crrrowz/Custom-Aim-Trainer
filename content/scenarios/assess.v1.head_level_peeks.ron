Scenario(
    id: "assess.v1.head_level_peeks",
    version: 1,
    kind: Assessment,
    timeout_s: 150.0,
    spawn_distance_m: 15.0,
    target_shape: WallPeek,
    layout: HeadLevelPeeks(
        peeks_count: 36,
        occluder_yaws_deg: [-25.0, 25.0],
