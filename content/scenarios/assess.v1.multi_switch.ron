Scenario(
    id: "assess.v1.multi_switch",
    version: 1,
    kind: Assessment,
    timeout_s: 45.0,
    spawn_distance_m: 15.0,
    target_shape: Sphere,
    layout: ConcurrentCluster(
        concurrent_count: 3,
        total_targets: 48, // Balanced multiple of 24 (3 distances x 8 octants x 2 reps)
        target_radius_deg: 0.55,
        distance_bins_deg: [10.0, 20.0, 35.0],
        octants: 8,
        min_separation_deg: 8.0,
        max_yaw_deg: 45.0,
        max_pitch_deg: 12.0,
        duration_s: 45.0,
    ),
    hit_rule: SingleShotKill,
)
